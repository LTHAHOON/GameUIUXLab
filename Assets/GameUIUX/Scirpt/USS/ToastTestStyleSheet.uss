.test-button {
    width: 200px;
    min-width: 140px;
    height: 50px;
    min-height: 50px;
    flex-shrink: 0;
    margin: 10px 8px;
    font-size: 15px;
    unity-text-align: middle-center;
}
.test-square-button {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    unity-text-align: middle-center;
    font-size: 18px;
}
.test-text{
    margin-left: 35px;
    margin-right: 35px;
    margin-top: 15px;
}
.score-test-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    width: 100%;
    padding-left: 8px;
    padding-right: 8px;
}
.score-delta-field {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 180px;
    margin: 10px 8px;
}
.score-step-button {
    width: 48px;
    min-width: 48px;
    height: 48px;
    min-height: 48px;
    margin: 10px 4px;
}
.score-reset-button {
    width: 100px;
    min-width: 100px;
    height: 48px;
    min-height: 48px;
    margin: 10px 4px;
    font-size: 13px;
}
